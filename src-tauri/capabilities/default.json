{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the prompt-optimizer window",
  "windows": ["main", "prompt-optimizer"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
